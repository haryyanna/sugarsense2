{
  "opencollection": "1.0.0",
  "info": {
    "name": "fatsecret Natural Language Processing API",
    "version": "1.0"
  },
  "request": {
    "auth": {
      "type": "oauth2",
      "flow": "client_credentials",
      "accessTokenUrl": "https://oauth.fatsecret.com/connect/token",
      "credentials": {
        "clientId": "{{clientId}}",
        "clientSecret": "{{clientSecret}}"
      }
    }
  },
  "items": [
    {
      "info": {
        "name": "Natural Language Processing",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Parse a free-text meal description",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://platform.fatsecret.com/rest/natural-language-processing/v1",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Accepts a natural-language description of what a user has eaten, which may contain multiple items, and returns the matched foods with suggested servings and nutritional content."
        }
      ]
    }
  ],
  "bundled": true
}