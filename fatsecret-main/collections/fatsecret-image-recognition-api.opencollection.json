{
  "opencollection": "1.0.0",
  "info": {
    "name": "fatsecret Image Recognition API",
    "version": "2.0"
  },
  "request": {
    "auth": {
      "type": "oauth2",
      "flow": "client_credentials",
      "accessTokenUrl": "https://oauth.fatsecret.com/connect/token",
      "credentials": {
        "clientId": "{{clientId}}",
        "clientSecret": "{{clientSecret}}"
      }
    }
  },
  "items": [
    {
      "info": {
        "name": "Image Recognition",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Recognize foods in an image",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://platform.fatsecret.com/rest/image-recognition/v2",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Accepts a Base64-encoded image of one or more foods and returns the identified foods with suggested servings and the nutritional content eaten."
        }
      ]
    }
  ],
  "bundled": true
}