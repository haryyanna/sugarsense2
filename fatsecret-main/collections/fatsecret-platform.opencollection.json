{
  "opencollection": "1.0.0",
  "info": {
    "name": "fatsecret Platform API",
    "version": "3.0"
  },
  "request": {
    "auth": {
      "type": "oauth2",
      "flow": "client_credentials",
      "accessTokenUrl": "https://oauth.fatsecret.com/connect/token",
      "credentials": {
        "clientId": "{{clientId}}",
        "clientSecret": "{{clientSecret}}"
      }
    }
  },
